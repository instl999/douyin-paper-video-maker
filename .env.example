# Copy to .env and fill in what you use. Real environment variables override this file.
# Never commit .env (it is git-ignored).

# --- Volcano Ark Agent Plan (images, TTS). The first of these that is set is used.
AGENT_PLAN_API_KEY=
# PVM_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# PVM_IMAGE_MODEL=doubao-seedream-5.0-lite
# PVM_IMAGE_CONCURRENCY=2
# PVM_IMAGE_ATTEMPTS=3          # retry budget per image, OCR failures included
# PVM_AFP_PER_IMAGE=99          # planning figure; revalidate against the account
# PVM_STYLE=paper-cut           # style pack in assets/style/

# --- Quota (spec §8.6). Tier sets the defaults; the monthly budget is paced over the days left.
PVM_PLAN_TIER=small
# PVM_AFP_MONTHLY_BUDGET=20000
# PVM_AFP_DAILY_BUDGET=          # only to override the paced daily allowance

# --- Voice. auto = Ark TTS when a key is set, otherwise edge-tts (free, fine for drafts).
PVM_TTS_ENGINE=auto
# PVM_TTS_SPEAKER=zh_male_jieshuoxiaoming_uranus_bigtts
# PVM_TTS_SPEED=10
# PVM_EDGE_VOICE=zh-CN-YunxiNeural
# PVM_EDGE_RATE=+10%

# --- LLM for pvm plan / pvm review. Without a key of its own it uses the Agent Plan key and model
# deepseek-v4-pro-beta (the plan includes DeepSeek text models). With PVM_LLM_API_KEY it calls DeepSeek directly.
PVM_LLM_API_KEY=
# PVM_LLM_BASE_URL=https://api.deepseek.com
# PVM_LLM_MODEL=deepseek-chat

# --- Research. A contact email gets polite-pool access to OpenAlex and Crossref.
PVM_CONTACT_EMAIL=
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=

# --- Rendering and compliance (spec §13)
# PVM_AI_LABEL=含AI生成内容      # visible AI-content label; "none" disables it (read spec §13.2 first)
# PVM_AIGC_PRODUCER=pvm        # ContentProducer in the AIGC metadata: your channel or company name
# PVM_ALLOW_SYSTEM_FONTS=0      # 1 allows Microsoft YaHei etc.; not for published videos
# PVM_X264_PRESET=veryfast
# PVM_CRF=20

# --- Move projects/, research/ and cache/ somewhere else
# PVM_HOME=
